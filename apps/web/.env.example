# Server-side MyAnimeList API client ID.
# Never prefix this with NEXT_PUBLIC_. Never send it to the browser.
# Register an application at https://myanimelist.net/apiconfigMAL_CLIENT_ID=

# Optional OpenAI-compatible semantic intent endpoint. Server-only.
# Never prefix these with NEXT_PUBLIC_. Leave empty to disable the LLM.
SEMANTIC_INTENT_API_KEY=
SEMANTIC_INTENT_BASE_URL=
SEMANTIC_INTENT_MODEL=
